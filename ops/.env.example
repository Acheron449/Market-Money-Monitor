# Copy to backend/.env (or the repo root) and fill in. Never commit real values.

# --- Required -----------------------------------------------------------------
# EDGAR requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT="Smart Money Monitor you@example.com"

# Alpaca market data (data-only keys; order endpoints are never used).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex on free plans (delayed); sip on paid plans.
ALPACA_FEED=iex

# Finnhub fallback.
FINNHUB_API_KEY=

# Bearer token for admin endpoints (watchlist writes, remote refresh).
ADMIN_TOKEN=

# sqlite+aiosqlite:///./smm.db for dev, postgresql+asyncpg://user:pass@db:5432/smm in Docker.
DATABASE_URL=sqlite+aiosqlite:///./smm.db

# --- Alerts (ADM-03) -----------------------------------------------------------
# Configure one or more channels. With none configured alerts are still recorded
# in GET /api/alerts as history, but nothing is delivered externally.
ALERTS_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Alert when one open-market transaction exceeds this USD value.
ALERT_TXN_THRESHOLD=1000000
# Alert when a ticker's net signal crosses this USD threshold in either direction.
ALERT_NET_THRESHOLD=10000000

# --- Optional -----------------------------------------------------------------
# Comma separated; the YAML watchlist overrides this.
WATCHLIST=NVDA,AAPL,TSLA,AMZN,META,AMD,PLTR,COIN
# Comma separated origin allow-list for the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Runtime YAML (watchlist, lookback, cadences, provider order).
SMM_CONFIG_FILE=smm.yaml
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
# false runs the API without any network providers (demo/offline).
PROVIDERS_ENABLED=true

# --- Build only ---------------------------------------------------------------
# Read-only token for TradingView's private Charting Library repository.
# Never a runtime variable, never in the browser bundle, never committed.
CHARTING_LIBRARY_TOKEN=
